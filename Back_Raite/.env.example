# Copia este archivo a .env y ajusta los valores:  cp .env.example .env

# --- Django ---
# Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esta-clave-por-una-propia
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:9002

# --- Base de datos (PostgreSQL local) ---
# postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgres://raite:raite@localhost:5432/raite

# Opcional: certificado CA para una base remota (ruta relativa a Back_Raite/).
# Déjalo vacío o comentado para una base local.
# DB_SSL_ROOTCERT=certs/ca.pem

# --- Correo (códigos de verificación) ---
# Con el backend de consola, los correos se imprimen en la terminal de runserver.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correos reales por SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=Raite <no-reply@localhost>

# --- Fotos de perfil (Cloudflare R2) ---
# Con las cuatro variables, las fotos se guardan en R2 (bucket privado; el API entrega URLs
# firmadas que vencen en una hora). Si falta alguna, se guardan en Back_Raite/media/.
# Los valores los da quien administra la cuenta de Cloudflare; nunca los subas al repo.
# R2_BUCKET=
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Producción (Render) ---
# Estas variables se escriben en el panel de Render, nunca en el repo (ver README, "Despliegue").
# Con DEBUG=False se activan la redirección a HTTPS, las cookies seguras y HSTS.
# DEBUG=False
# ALLOWED_HOSTS=raite-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://raite-web.onrender.com
# CSRF_TRUSTED_ORIGINS=https://raite-web.onrender.com
# DATABASE_URL=postgresql://usuario:clave@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# SECURE_HSTS_SECONDS=3600
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=raite.uacj@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicacion
# DEFAULT_FROM_EMAIL=Raite <raite.uacj@gmail.com>
# R2_BUCKET=raite-fotos
# R2_ENDPOINT_URL=https://<id-de-cuenta>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
